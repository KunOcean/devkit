# 多语言构建工具链位置（不在系统 PATH，构建脚本自行 source 本文件）
# 生成于 2026-10-30，随 CCWorks/toolchains/ 一起维护。

TOOLCHAINS_ROOT="D:/dai/ccworks/toolchains"

# Rust（GNU 目标，复用 MinGW 链接器）
export RUSTUP_HOME="$TOOLCHAINS_ROOT/rust/rustup"
export CARGO_HOME="$TOOLCHAINS_ROOT/rust/cargo"
export RUSTFLAGS="-C link-self-contained=yes"

# Go
export GOROOT="$TOOLCHAINS_ROOT/go/go"

# Node.js
export NODE_HOME="$TOOLCHAINS_ROOT/node/node"

# .NET SDK
export DOTNET_ROOT="$TOOLCHAINS_ROOT/dotnet"

# MinGW (w64devkit)
export MINGW_HOME="$TOOLCHAINS_ROOT/mingw"

# Python + PyInstaller
export PYINSTALLER_PATH="$TOOLCHAINS_ROOT/python/site-packages"

# 统一 PATH
export PATH="$CARGO_HOME/bin:$GOROOT/bin:$NODE_HOME:$DOTNET_ROOT:$MINGW_HOME/bin:$PATH"
